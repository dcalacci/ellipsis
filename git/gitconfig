[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  required = true
  process = git-lfs filter-process

[alias]
  st = status -s
  ci = commit
  co = checkout
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  restore = "!f() { git co $(git rev-list -n 1 HEAD -- $1)~1 -- $(git diff --name-status $(git rev-list -n 1 HEAD -- $1)~1 head | grep '^D' | cut -f 2) }; f"

[color]
  diff = auto
  status = auto
  branch = auto
  ui = true

[core]
  # setup.sh links git/gitignore here, not to ~/.gitignore
  excludesfile = ~/.config/git/ignore
  editor = nvim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  line-numbers = true
  syntax-theme = Nord

[diff]
  colorMoved = default

[merge]
  conflictstyle = zdiff3

[rerere]
  enabled = true

[apply]
  whitespace = nowarn

[user]
  email = dana@dcalacci.net
  name = Dana Calacci

[branch]
  autosetuprebase = always

[push]
  default = simple

[credential]
	helper = osxkeychain

[init]
	defaultBranch = main
